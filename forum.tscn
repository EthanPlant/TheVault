Author = "Anonymous (15:25)"
Post = "The Vault is real. It's there, hidden in plain sight. The question is not whether you can find it, but whether you will make it out alive. You should be cautious with what you seek.You’re about to uncover what most can’t even begin to imagine…"

[node name="ForumPost2" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer" instance=ExtResource("2_kplmg")]
layout_mode = 2
size_flags_vertical = 3
Author = "Anonymous (15:26)"
Post = "The Vault is closer than you think. Solve the following riddle and gain access to the next step. But be warned—only the keenest eyes will see the truth hidden within .The first clue lies within the second sentence. Read between the lines: \"I am not alive, but I grow. I do not have lungs, but I need air. I do not have a mouth, but water kills me. Find the key. Good luck, Seeker."

