[node name="HiddenNetworkPost" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer" instance=ExtResource("3_lntbi")]
layout_mode = 2
size_flags_vertical = 3

[node name="Author" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost" index="0"]
text = "Author: FailedToEscape"

[node name="Title" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost" index="1"]
text = "The Vault's Trap: How I Got Caught"

[node name="Post" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost" index="2"]
text = "I thought I had everything figured out. The clues were too easy, and then it hit me. They were watching. After I accessed the Vault, I found files, documents—things that would’ve ruined me. But the system was already tracking me. The last message I saw was a countdown. I never finished reading it. If you're reading this, it’s probably too late for me. I tried to erase myself, but it’s not that simple. The Vault has ways of tracking. Don’t make the same mistake."

[node name="HiddenNetworkPost2" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer" instance=ExtResource("3_lntbi")]
layout_mode = 2
size_flags_vertical = 3

[node name="Author" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost2" index="0"]
text = "Author: OuOfSight"

[node name="Title" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost2" index="1"]
text = "Escaping the Vault"

[node name="Post" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost2" index="2"]
text = "I made it. I don’t know how. But the moment I saw the Vault’s contents, I knew it was a mistake. I’m hiding now, and I’m not sure for how long. It’s not what you think it is. I got in, but I can’t go back. I’ve seen it—the files are real. Some things should never be accessed. Whatever you do, don’t try to reach the second access point. It’s a trap. Trust me. Stay away. If you're successful, you won't be able to leave."

[node name="HiddenNetworkPost7" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer" instance=ExtResource("3_lntbi")]
layout_mode = 2
size_flags_vertical = 3

[node name="Author" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost7" index="0"]
text = "Author: CuriousMind"

[node name="Title" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost7" index="1"]
text = "Nothing is as it Seems"

[node name="Post" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost7" index="2"]
text = "Been digging deeper into these pages and everything seems connected in strange ways. It's like trying to solve a puzzle, but the pieces are in plain sight. Sometimes the most important clues are just there... if you know where to look. I've been staring at this one thing for hours now. Look at the corners, maybe that's where things start to make sense."

[node name="HiddenNetworkPost4" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer" instance=ExtResource("3_lntbi")]
layout_mode = 2
size_flags_vertical = 3

[node name="Author" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost4" index="0"]
text = "Author: Watcher"

[node name="Title" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost4" index="1"]
text = "Is it Worth it? A Final Warning"

[node name="Post" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost4" index="2"]
text = "The Vault... it’s nothing like I imagined. I've spent days trying to understand what I saw, but I can’t. The more I go through the files, the more I see their names. Who are they? I thought I was alone. I don't know who else is trying to access this. I’m on my own now. Don’t trust anyone here. If you make it through the next layer, there’s no going back. You'll be marked. I’m leaving this message, but I won’t be surprised if it gets deleted. You won’t see me again."

[node name="HiddenNetworkPost6" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer" instance=ExtResource("3_lntbi")]
layout_mode = 2
size_flags_vertical = 3

[node name="Author" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost6" index="0"]
text = "Author: TimeSeeker"

[node name="Title" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost6" index="1"]
text = "The Thread of Time"

[node name="Post" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost6" index="2"]
text = "Time has a funny way of moving forward, just like the hands of a clock. I've been following the clues for days, and something strange happens every third time I refresh the page. After three times, I get a strange code. But maybe that's not all. You see, when I first started there were two forums I needed to access, and both have a pattern of numbers. One of those numbers, I believe, is seven."

[node name="HiddenNetworkPost8" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer" instance=ExtResource("3_lntbi")]
layout_mode = 2
size_flags_vertical = 3

[node name="Author" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost8" index="0"]
text = "Author: FrustratedOne"

[node name="Title" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost8" index="1"]
text = "Am I missing something?"

[node name="Post" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost8" index="2"]
text = "I've tried everything. The clues in the text, the files, the numbers—nothing works. But there's something I can't get out of my mind. I'm seeing patterns, and it's not just in the messages. Something keeps catching my eye. Can't shake the feeling that I'm overlooking the obvious. But what if the solution is just... right there? Starting at you from the edges."

[node name="HiddenNetworkPost5" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer" instance=ExtResource("3_lntbi")]
layout_mode = 2
size_flags_vertical = 3

[node name="Author" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost5" index="0"]
text = "Author: NULL"

[node name="Post" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost5" index="2"]
text = "The Vault is not what you think. It’s something else. The end of the road is just the beginning of a much darker path. You’ve been warned."

[node name="HiddenNetworkPost3" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer" instance=ExtResource("3_lntbi")]
layout_mode = 2
size_flags_vertical = 3

[node name="Author" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost3" index="0"]
text = "Author: Removed"

[node name="Title" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost3" index="1"]
text = "[removed]"

[node name="Post" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost3" index="2"]
text = "Thread removed by moderator. Reason: Violating terms of service.

User was banned for this post."

[node name="HiddenNetworkPost9" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer" instance=ExtResource("3_lntbi")]
layout_mode = 2
size_flags_vertical = 3

[node name="Author" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost9" index="0"]
text = "Author: Valkyrie"

[node name="Title" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost9" index="1"]
text = "It's all in the design"

[node name="Post" parent="MarginContainer/HBoxContainer/Posts/MarginContainer/ScrollContainer/VBoxContainer/HiddenNetworkPost9" index="2"]
text = "I know this might seem trivial, but every site, even the most complex, has patterns. The Vault has no wasted space.

Look at every part of the interface—even the small things. You might find that the page is trying to direct you. There's a reason why everything is where it is."

