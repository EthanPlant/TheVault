theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("2_lntbi")
theme_override_font_sizes/font_size = 16
text = "Now, you’re standing at the precipice, and the last door is just ahead. But the final key isn’t freely given—it’s embedded in what you've just uncovered. Something in the threads, in the warnings, in the dark corners you barely noticed.

The Vault won’t give up its secrets easily. It never does.

\"The code you need is in your hands now—hidden in plain sight. You’ll find it in the details of the Hidden Network. Look carefully. The final door opens only to those who can unlock what’s been buried in the threads of those who came before you.\""
